VIP=192.168.1.53/24
# LAN interface on this host (ip -br a)
INTERFACE=eth0
SRC_IP=192.168.1.A
PEER_IPS=192.168.1.B
AUTH_PASS=changeme
STATE=BACKUP
PRIORITY=150

# nebula-sync (only on the node that runs it; start with --profile sync).
# Format: http(s)://host:port|pihole-password, use node IPs, not the VIP.
SYNC_PRIMARY=http://192.168.1.A:80|changeme
SYNC_REPLICAS=http://192.168.1.B:80|changeme
# SYNC_CRON=*/30 * * * *
